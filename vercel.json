{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "backend/src/**",
          "backend/node_modules/**",
          "backend/package.json"
        ]
      }
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "installCommand": "cd backend && npm install",
  "routes": [
    { "src": "/users(.*)", "dest": "/api/index.js" },
    { "src": "/sessions(.*)", "dest": "/api/index.js" },
    { "src": "/post(.*)", "dest": "/api/index.js" },
    { "src": "/messages(.*)", "dest": "/api/index.js" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}
